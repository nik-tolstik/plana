# Порт API
PORT=3000

# Разрешённые CORS-источники (фронт), через запятую
CLIENT_ORIGIN=http://localhost:5173

# Версия приложения (показывается в /v1/health)
APP_VERSION=dev

# PostgreSQL: локальный инстанс из docker-compose.yml (план: plana, порт 55434)
DATABASE_URL=postgres://plana:plana@localhost:55434/plana

# --- заполняются на следующих шагах реализации ---

# Auth: JWT_SECRET=...
# Google OAuth: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Web Push: VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY
# Railway Object Storage: S3_ENDPOINT / S3_BUCKET / S3_REGION / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
